{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null) && [ -x \"$ROOT/.venv/bin/tox\" ] && \"$ROOT/.venv/bin/tox\" -e formats 2>/dev/null || true",
            "timeout": 120,
            "statusMessage": "Formatting..."
          }
        ]
      }
    ]
  }
}
